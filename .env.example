# Copy this file to .env and fill in your values for local development.
# .env is gitignored and will never be committed.
# In Docker / Dockge, set these in the compose environment: block instead.

# ── Required ────────────────────────────────────────────────────────────────
IMMICH_URL=http://192.168.1.200:2283
IMMICH_API_KEY=your-api-key-here
HORIZONTAL_ALBUM_ID=your-horizontal-album-uuid
VERTICAL_ALBUM_ID=your-vertical-album-uuid

# ── Optional ────────────────────────────────────────────────────────────────
# PORT=8765
# DATE_FORMAT=%b %-d, %y
# OVERLAY_OPACITY=40
# TEXT_OPACITY=180
# FONT_SIZE_DIVISOR=30
# MARGIN_DIVISOR=70
